+    // Read-only diagnostics: compare aggregation paths and inspect actual record origins.
+    @PluginMethod
+    fun diagnoseSteps(call: PluginCall) {
+        val start: Instant
+        val end: Instant
+        try {
+            start = Instant.parse(call.getString("startDate"))
+            end = Instant.parse(call.getString("endDate"))
+            require(end.isAfter(start) && end.epochSecond - start.epochSecond <= 90000) { "Select one local day" }
+        } catch (e: Exception) {
+            call.reject("Invalid diagnostic date range: ${e.message}")
+            return
+        }
+        CoroutineScope(Dispatchers.IO).launch {
+            try {
+                if (!hasPermission(CapHealthPermission.READ_STEPS)) {
+                    call.reject("Step read permission is not granted")
+                    return@launch
+                }
+                val result = JSObject()
+                result.put("schemaVersion", 1)
+                result.put("startDate", start.toString())
+                result.put("endDate", end.toString())
+                result.put("timeZone", ZoneId.systemDefault().id)
+                result.put("androidApi", android.os.Build.VERSION.SDK_INT)
+                result.put("combined", diagnosticStepTotals(start, end, null))
+                result.put("samsung", diagnosticStepTotals(start, end, "com.sec.android.app.shealth"))
+
+                val bySource = linkedMapOf<String, MutableList<StepsRecord>>()
+                var token: String? = null
+                var pages = 0
+                var rawComplete = false
+                try {
+                    do {
+                        val response = healthConnectClient.readRecords(
+                            ReadRecordsRequest(StepsRecord::class, TimeRangeFilter.between(start, end),
+                                emptySet(), true, 1000, token)
+                        )
+                        response.records.forEach { record ->
+                            bySource.getOrPut(record.metadata.dataOrigin.packageName) { mutableListOf() }.add(record)
+                        }
+                        token = response.pageToken
+                        pages++
+                    } while (token != null && pages < 100)
+                    rawComplete = token == null
+                    if (!rawComplete) result.put("rawError", "Record scan reached the 100-page limit")
+                } catch (e: Exception) {
+                    result.put("rawError", e.message ?: e.javaClass.simpleName)
+                }
+                result.put("rawComplete", rawComplete)
+                result.put("pagesRead", pages)
+                result.put("recordsRead", bySource.values.sumOf { it.size })
+                val sources = JSArray()
+                bySource.entries.take(32).forEach { (packageName, records) ->
+                    val source = JSObject()
+                    source.put("packageName", packageName)
+                    source.put("recordCount", records.size)
+                    // Raw records can overlap and cross midnight. This is not a daily total.
+                    source.put("rawRecordStepSum", records.sumOf { it.count })
+                    source.put("latestRecordEnd", records.maxOf { it.endTime }.toString())
+                    source.put("watchRecords", records.count { it.metadata.device?.type == androidx.health.connect.client.records.metadata.Device.TYPE_WATCH })
+                    source.put("phoneRecords", records.count { it.metadata.device?.type == androidx.health.connect.client.records.metadata.Device.TYPE_PHONE })
+                    source.put("otherDeviceRecords", records.count {
+                        it.metadata.device?.type != androidx.health.connect.client.records.metadata.Device.TYPE_PHONE &&
+                        it.metadata.device?.type != androidx.health.connect.client.records.metadata.Device.TYPE_WATCH
+                    })
+                    source.put("totals", diagnosticStepTotals(start, end, packageName))
+                    sources.put(source)
+                }
+                result.put("sources", sources)
+                result.put("sourcesTruncated", bySource.size > 32)
+                call.resolve(result)
+            } catch (e: Exception) {
+                call.reject("Step diagnostics failed: ${e.message}")
+            }
+        }
+    }
+
+    private suspend fun diagnosticStepTotals(start: Instant, end: Instant, sourcePackage: String?): JSObject {
+        val result = JSObject()
+        val origins = sourcePackage?.let { setOf(DataOrigin(it)) } ?: emptySet()
+        try {
+            val aggregate = healthConnectClient.aggregate(AggregateRequest(
+                setOf(StepsRecord.COUNT_TOTAL), TimeRangeFilter.between(start, end), origins
+            ))
+            result.put("directSteps", aggregate[StepsRecord.COUNT_TOTAL] ?: org.json.JSONObject.NULL)
+            val packages = JSArray()
+            aggregate.dataOrigins.map { it.packageName }.sorted().forEach { packages.put(it) }
+            result.put("contributingPackages", packages)
+        } catch (e: Exception) {
+            result.put("directError", e.message ?: e.javaClass.simpleName)
+        }
+        try {
+            val localStart = start.atZone(ZoneId.systemDefault()).toLocalDateTime()
+            val localEnd = end.atZone(ZoneId.systemDefault()).toLocalDateTime()
+            val rows = queryAggregatedMetric(getMetricAndMapper("steps"),
+                TimeRangeFilter.between(localStart, localEnd), Period.ofDays(1), sourcePackage)
+            val values = rows.mapNotNull { it.value }
+            result.put("bucketSteps", if (values.isEmpty()) org.json.JSONObject.NULL else values.sum())
+        } catch (e: Exception) {
+            result.put("bucketError", e.message ?: e.javaClass.simpleName)
+        }
+        return result
+    }
